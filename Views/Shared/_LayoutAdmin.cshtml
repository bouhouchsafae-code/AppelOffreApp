@{
    var userName = Context.Session.GetString("UserName");
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin - AppelOffreApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="d-flex" style="min-height: 100vh;">
        <!-- Sidebar -->
        <div class="bg-dark text-white p-3" style="width: 250px;">
            <h4>👤 Admin</h4>
            <p>@userName</p>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Admin" asp-action="Index">🏠 Tableau de bord</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="AppelOffre" asp-action="Create">➕ Créer Appel d'Offre</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="AppelOffre" asp-action="List">📋 Liste Appels</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Marche" asp-action="Liste">📄 Liste Marchés</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Auth" asp-action="Logout">🚪 Déconnexion</a>
                </li>
            </ul>
        </div>

        <!-- Main content -->
        <div class="flex-grow-1 p-4">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
